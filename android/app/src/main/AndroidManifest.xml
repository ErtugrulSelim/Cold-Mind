<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Atlas draws a real map, and a map is tiles fetched over the network.
         This lived only in the debug manifest, which Flutter writes for hot
         reload — so the map worked while developing and would never have
         loaded a single tile in a release build. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The reminder that brings a player back to an unfinished case.
         POST_NOTIFICATIONS is asked for at runtime on Android 13 and later;
         RECEIVE_BOOT_COMPLETED is what lets a reminder scheduled days out
         survive the phone being restarted, which it otherwise would not. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Cold Mind"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- `flutter_local_notifications` delivers a scheduled reminder
             through the first receiver, and re-registers everything still
             pending through the second after a reboot or an app update.
             Without the boot receiver every scheduled reminder is silently
             dropped the first time the phone restarts. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11 hides other apps from this one unless they are declared
             here, and `url_launcher` asks the system which app can open a URL
             before opening it. Undeclared, that question comes back empty and
             every outward link **fails silently** — no browser, no error, a
             tap that does nothing.

             That is four things: Terms of Use and Privacy Policy, on the
             paywall and in Settings, which both stores require to actually
             open from the screen that takes money; Rate Us, which goes to the
             Play listing over https; and the share sheet's download link. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
