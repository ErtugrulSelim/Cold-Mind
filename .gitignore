# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# Generated by build_runner, and committed on purpose — see CLAUDE.md.
# Ignoring them is the Dart convention, and it cost this project a broken
# build every time a branch was switched: git leaves an untracked file alone,
# so main's generated code stayed on disk under android's source and the app
# would not compile until somebody remembered the command. Tracked, git swaps
# them with everything else, and a fresh clone runs.

# Android
android/.gradle/
android/local.properties
android/key.properties
**/android/**/gradle-wrapper.jar
*.jks
*.keystore

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/xcuserdata/

# Secrets
.env

# The Play service account key RevenueCat validates purchases with. Google
# names the download `<project>-<hash>.json`, which looks like any other
# config file sitting in a project root — and it is the one file that lets
# whoever holds it read this app's orders and revenue. Ignored by shape
# rather than by name, since the name is whatever the browser saved.
*-service-account*.json
service-account*.json
coldmind-koalacache-*.json
play-store-credentials*.json

# OS
.DS_Store
Thumbs.db
